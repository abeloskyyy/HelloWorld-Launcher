{
  "name": "helloworld-launcher",
  "version": "2.1.0",
  "description": "The official custom Minecraft launcher for the HelloWorld community, featuring fast updates, rich presence, and smooth performance.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abeloskyyy/HelloWorld-Launcher.git"
  },
  "main": "main.js",
  "scripts": {
    "test": "electron .",
    "start": "node scripts/start.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win -p never --config.win.target=zip",
    "build:linux": "electron-builder --linux -p never",
    "build:mac": "electron-builder --mac -p never"
  },
  "build": {
    "appId": "com.abelosky.helloworldlauncher",
    "productName": "HelloWorld-Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "secrets.json",
      "src/**/*",
      "ui/**/*",
      "!docs/**",
      "!screenshots/**",
      "!installer/**",
      "!scripts/**",
      "!release/**",
      "!dist/**",
      "!**/*.md",
      "!.github/**",
      "!**/serviceAccountKey.json",
      "!**/*-firebase-adminsdk-*.json"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "sign": null,
      "artifactName": "helloworld-launcher-win.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Game",
      "artifactName": "helloworld-launcher-linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "artifactName": "helloworld-launcher-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Abeloskyyy",
        "repo": "HelloWorld-Launcher"
      }
    ],
    "npmRebuild": false
  },
  "author": {
    "name": "Abelosky",
    "email": "abelosky.dev@gmail.com"
  },
  "homepage": "https://github.com/Abeloskyyy/HelloWorld-Launcher",
  "license": "ISC",
  "devDependencies": {
    "electron": "^40.1.0",
    "electron-builder": "^24.13.3",
    "firebase-admin": "^14.2.0"
  },
  "dependencies": {
    "adm-zip": "^0.4.16",
    "axios": "^1.13.4",
    "discord-rich-presence": "^0.0.8",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "firebase": "^12.17.0",
    "form-data": "^4.0.5",
    "fs-extra": "^11.3.3",
    "graceful-fs": "^4.2.11",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "prismarine-nbt": "^2.8.0",
    "uuid": "^13.0.0"
  }
}